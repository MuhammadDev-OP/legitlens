{
  "name": "legitlens",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LegitLens — free anti-scam & fake-shop checker, by Qurtuba Labs · powered by Codinito",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "lint": "eslint \"packages/rules/{src,tests}/**/*.{ts,tsx}\" \"apps/extension/{entrypoints,lib}/**/*.{ts,tsx}\" \"apps/web/src/**/*.{ts,tsx}\"",
    "typecheck": "pnpm --filter @legitlens/rules build && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm --filter @legitlens/rules build && pnpm --filter @legitlens/web build && pnpm --filter @legitlens/extension build",
    "dev:web": "pnpm --filter @legitlens/web dev",
    "dev:extension": "pnpm --filter @legitlens/extension dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "adm-zip": ">=0.6.1",
      "tar": ">=7.5.21",
      "tmp": ">=0.2.6",
      "shell-quote": ">=1.9.0",
      "tinypool": ">=2.1.2",
      "postcss": ">=8.5.18"
    }
  }
}
